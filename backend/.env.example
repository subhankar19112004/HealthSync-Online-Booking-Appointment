# Copy this file to .env for local development and replace every placeholder.
# Never commit your real .env file or paste credentials into chat.

PORT=4000
NODE_ENV=development

# Use the MongoDB Atlas connection string with a URL-encoded database password.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=quickcare

# Comma-separated frontend origins. Use your deployed frontend/admin URLs in production.
CLIENT_URL=http://localhost:5173,http://localhost:5174

CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
JWT_SECRET=replace_with_a_long_random_secret

# Use Razorpay test credentials for development.
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
